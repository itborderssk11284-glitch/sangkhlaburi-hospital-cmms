rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connectivity test document
    match /test/connection {
      allow read, write: if true;
    }
    
    // Work orders collection (บันทึกงานซ่อมบำรุง)
    match /work_orders/{orderId} {
      allow read, write, delete: if true;
    }

    // Assets collection (ทะเบียนครุภัณฑ์)
    match /assets/{assetId} {
      allow read, write, delete: if true;
    }

    // Spare parts collection (คลังอะไหล่และสต็อก)
    match /spare_parts/{partId} {
      allow read, write, delete: if true;
    }

    // Technicians collection (ข้อมูลทีมช่างและภาระงาน)
    match /technicians/{techId} {
      allow read, write, delete: if true;
    }

    // System users collection (จัดการบัญชีผู้ใช้และกำหนดสิทธิ์โดยแอดมิน)
    match /users/{userId} {
      allow read, write, delete: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
